# ==============================================================================
# Git Ignore Rules for Aglibol Agent
# Standard Open-Source Repository Configuration
# ==============================================================================

# --- Byte-compiled / Optimized Python files ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- Distribution / Packaging ---
dist/
build/
*.egg-info/
.eggs/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
*.egg
MANIFEST
wheels/
share/python-wheels/
*.whl
*.tar.gz

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
venv.bak/
.conda/

# --- Testing, Coverage & QA ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
nosetests.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Type Checking & Linters ---
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# --- Aglibol Local Storage & Databases ---
.aglibol/
~/.aglibol/
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# --- Secrets, Credentials & Local Configs ---
.env
.env.*
*.env
*.pem
*.key
*.token
*.secret
id_rsa*
*.id_rsa

# --- Scratch & Local Development Artifacts ---
scratch/
tmp/
temp/
*.log
*.tmp
*.bak
Ultralytics/

# --- Node.js & NPX Package ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
npm/*.tgz
*.tgz

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# --- IDEs & Text Editors ---
.idea/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
