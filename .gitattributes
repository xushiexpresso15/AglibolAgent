# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# POSIX shell scripts
*.sh text eol=lf

# Python files
*.py text eol=lf diff=python
*.pyi text eol=lf diff=python

# Documentation and configs
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.tar.gz binary
*.whl binary
*.db binary
*.sqlite binary
